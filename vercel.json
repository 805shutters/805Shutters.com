{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/appointment-reminders/",
      "schedule": "0 2,3 * * *"
    },
    {
      "path": "/api/cron/order-cogs/",
      "schedule": "0 3,4,15,16 * * *"
    },
    {
      "path": "/api/cron/square-contract-reminders",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/overdue-alerts",
      "schedule": "13 17 * * *"
    },
    {
      "path": "/api/cron/stale-quotes",
      "schedule": "19 17 * * *"
    },
    {
      "path": "/api/cron/payment-plan-reminders",
      "schedule": "35 17 * * *"
    },
    {
      "path": "/api/cron/commercial-campaigns",
      "schedule": "5 18 * * 1-5"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "45 18 * * 1"
    },
    {
      "path": "/api/cron/ken-payment-review",
      "schedule": "43 17 * * *"
    },
    {
      "path": "/api/cron/booking-outbox/",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/installer-delivery/",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron/customer-signed-contract-email/",
      "schedule": "*/3 * * * *"
    },
    {
      "path": "/api/cron/weekly-sales/",
      "schedule": "0 0,1 * * 1"
    },
    {
      "path": "/api/cron/square-payments/",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/installation-invoices/",
      "schedule": "7 * * * *"
    }
  ]
}
