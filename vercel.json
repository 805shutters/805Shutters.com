{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/visitor-alerts",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/order-cogs",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/overdue-alerts",
      "schedule": "13 17 * * *"
    },
    {
      "path": "/api/cron/stale-quotes",
      "schedule": "19 17 * * *"
    },
    {
      "path": "/api/cron/payment-plan-reminders",
      "schedule": "35 17 * * *"
    },
    {
      "path": "/api/cron/commercial-campaigns",
      "schedule": "5 18 * * 1-5"
    },
    {
      "path": "/api/cron/commercial-bid-opportunities",
      "schedule": "17 * * * *"
    },
    {
      "path": "/api/cron/indexnow",
      "schedule": "45 18 * * 1"
    }
  ]
}
