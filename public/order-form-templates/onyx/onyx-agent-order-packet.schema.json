                  "106_Silk White",
                  "107_Swiss Coffee",
                  "110_Creamy",
                  "120_Butter",
                  "130_Gray",
                  "150_Onyx Black",
                  "190_Paint (Primed)",
                  "191_Norman Paint",
                  "192_Sunland Paint",
                  "900_Custom Paint"
                ]
              },
              "louver": {
                "enum": [
                  "2 1/2",
                  "3 1/2",
                  "4 1/2"
                ]
              },
              "tilt_rod": {
                "enum": [
                  "Center",
                  "Hidden2 (Notch on Louver)",
                  "Hidden3",
                  "Off Set"
                ]
              },
              "other_options": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "Raised Panel",
                    "Solid Flat Panel"
                  ]
                }
              }
            }
          }
