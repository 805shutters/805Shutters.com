      {
        "@type": "FAQPage",
        "@id": "https://www.805shutters.com/shades/#faq",
        "mainEntity": [
          {
            "@type": "Question",
            "name": "Which custom shade is best for glare and privacy?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "The best shade depends on the room. Roller and solar shades are strong for glare and large glass, honeycomb shades add softness and insulation, woven shades add texture, and room-darkening fabrics help bedrooms and media rooms."
            }
          },
          {
            "@type": "Question",
            "name": "Do you offer motorized window shades?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. Motorized shades can be discussed for tall windows, hard-to-reach openings, repeated windows, and rooms where grouped shade control would make daily use easier."
            }
          },
          {
            "@type": "Question",
            "name": "Can I compare roller, honeycomb, Roman, and woven shades in one visit?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Yes. A consultation can compare shade styles, fabric opacity, color, privacy, view-through, control side, mounting depth, and room-darkening needs before a final recommendation is made."
            }
          }
        ]
