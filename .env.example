# Server-side Google Maps Platform key for address autocomplete (Places API New).
# Powers the address fields on the booking calendar, CRM jobs/appointments, and
# quote builder. Stays server-only — the browser calls /api/places/* which call
# Google with this key. Restrict the key to "Places API (New)". Leave blank to
# disable autocomplete (address fields fall back to plain text inputs).
GOOGLE_MAPS_API_KEY=
GOOGLE_CALENDAR_ID=805@805shutters.com
GOOGLE_CALENDAR_TIME_ZONE=America/Los_Angeles
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# Service account (Workspace domain-wide delegation) used to mirror self-booked
# and CRM-created appointments into Google Calendar. From the downloaded JSON key.
